# Copy to .env for local development. .env is read at startup and never committed.

DJANGO_DEBUG=1
# Production: set a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind HTTPS, e.g. https://scoutly.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 when a reverse proxy (nginx, a PaaS router) terminates HTTPS and sets X-Forwarded-For/-Proto
DJANGO_BEHIND_PROXY=0

# MongoDB connection string. Local server: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
# Database name (tests use test_<name>)
MONGODB_NAME=scoutly

# Optional data sources
# Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Turns on search volume, rankings, traffic and backlinks (paid): https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Audits per hour per visitor (anonymous / logged in)
SCOUTLY_AUDITS_PER_HOUR=20
SCOUTLY_AUDITS_PER_HOUR_USER=60
# Lets you audit localhost while testing. Never set this in production.
SCOUTLY_ALLOW_PRIVATE=0
