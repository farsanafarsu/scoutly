// Cloudflare Workers site. Deployed from the main branch.
// Pages and assets are static; /api/* runs worker.js, which forwards it to the hosted Python server.
{
  "name": "scoutly",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // serve 404.html (with a 404 status) for addresses that don't exist
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // the hosted Python server, e.g. https://scoutly-api.onrender.com (no trailing slash).
    // API_KEY is a secret set in the Cloudflare dashboard, not here.
    "API_ORIGIN": "https://scoutly-api.onrender.com"
  }
}
